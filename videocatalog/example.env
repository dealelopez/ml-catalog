# Ruta al directorio de vídeos en el host
VIDEOS_PATH=/mnt/z2d1/50-59--recursos/51--tutoriales/51.003--tecnologia/midudev-desarrollo
# DATA_PATH: ruta en el HOST que se monta en /app/data del contenedor
