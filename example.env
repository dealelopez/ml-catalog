# =============================================================================
# example.env — videocatalog (Docker)
# =============================================================================
# Copiar a .env y ajustar:  cp example.env .env
# .env nunca se versiona (ver .gitignore).
# =============================================================================

# --- Vídeos (host) ---
# Directorio de vídeos en el host. Se monta en /videos:ro (solo lectura).
# La app nunca modifica tus ficheros.
VIDEOS_PATH=/videos

# --- Datos persistentes (host) ---
# Directorio del host que se monta en /app/data del contenedor.
# Aquí viven catalog.db, model.joblib, labels.csv, metrics.json.
DATA_PATH=./data

# --- BD (ruta INTERNA al contenedor, relativa a /app) ---
# No usar rutas del host aquí. Debe coincidir con el montaje /app/data.
DB_PATH=data/catalog.db

# --- Jev / Vercel AI Gateway (opcional, solo etiquetado masivo dev) ---
# Si no está definida, scripts/label_with_jev.py avisa y sale sin tocar la BD.
AI_GATEWAY_API_KEY=

# --- UID/GID (evita problemas de permisos en volúmenes) ---
# Obtener con: id -u  y  id -g
PUID=1000
PGID=1000
